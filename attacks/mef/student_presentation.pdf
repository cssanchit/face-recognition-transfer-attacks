/T (Input: x, target embedding e_t, model f eps=0.062, T=5, K=20 mu_in=0.9, mu_out=0.5, gamma=2.0, kesai=0.15 adv <- x; g_prev <- 0; g_pgia[K] <- 0)
/E (Input: x, target embedding e_t, model f eps=0.062, T=5, K=20 mu_in=0.9, mu_out=0.5, gamma=2.0, kesai=0.15 adv <- x; g_prev <- 0; g_pgia[K] <- 0)
/Pg 16 0 R
/K [5]
>>
