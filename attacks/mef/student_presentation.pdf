240 0 obj
<<
/Type /StructElem
/S /H4
/P 120 0 R
/T (for t = 1..T:   grads <- []   for k = 1..K:     noise  <- U\(-gamma*eps, gamma*eps\)     x_near <- adv + noise     x_min  <- x_near + kesai*eps*g_pgia[k]     grad_k <- d/dx_min AttackLoss\(f\(x_min\), e_t\)     grads.append\(grad_k\))
/E (for t = 1..T:   grads <- []   for k = 1..K:     noise  <- U\(-gamma*eps, gamma*eps\)     x_near <- adv + noise     x_min  <- x_near + kesai*eps*g_pgia[k]     grad_k <- d/dx_min AttackLoss\(f\(x_min\), e_t\)     grads.append\(grad_k\))
/Pg 16 0 R
/K [6]
>>
endobj
241 0 obj
<<
/Type /StructElem
/S /H4
/P 120 0 R
/T (  g_pgia <- normalize\(grads\) - mu_in * g_pgia   # inner momentum   grad   <- mean\(grads\)                          # expectation over   grad   <- normalize\(grad\)                       # the neighborhood   grad   <- grad + mu_out * g_prev                # outer momentum   g_prev <- grad)
/E (  g_pgia <- normalize\(grads\) - mu_in * g_pgia   # inner momentum   grad   <- mean\(grads\)                          # expectation over   grad   <- normalize\(grad\)                       # the neighborhood   grad   <- grad + mu_out * g_prev                # outer momentum   g_prev <- grad)
/Pg 16 0 R
/K [7]
>>
endobj
